<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.example.foodviet"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodViet">

        <!-- LAUNCHER có intent-filter => PHẢI khai báo exported -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Các activity KHÔNG có intent-filter: có thể để mặc định hoặc khai báo rõ ràng exported=false -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DishDetailActivity"
            android:parentActivityName=".ui.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FavoritesActivity"
            android:parentActivityName=".ui.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AddDishActivity"
            android:parentActivityName=".ui.MainActivity"
            android:exported="false" />
    </application>
</manifest>
